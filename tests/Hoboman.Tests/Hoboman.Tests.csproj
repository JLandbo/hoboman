<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="Xunit" />
    <Using Include="Microsoft.Extensions.Logging.Abstractions" />
    <Using Include="Hoboman.Core.Auth" />
    <Using Include="Hoboman.Core.Base64" />
    <Using Include="Hoboman.Core.Environments" />
    <Using Include="Hoboman.Core.History" />
    <Using Include="Hoboman.Core.Languages" />
    <Using Include="Hoboman.Core.Requests" />
    <Using Include="Hoboman.Core.Sending" />
    <Using Include="Hoboman.Core.Settings" />
    <Using Include="Hoboman.Core.Storage" />
    <Using Include="Hoboman.Core.Text" />
    <Using Include="Hoboman.Mvvm" />
    <Using Include="Hoboman.ViewModels" />
    <Using Include="Hoboman.Views" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hoboman.Cli\Hoboman.Cli.csproj" />
    <ProjectReference Include="..\..\src\Hoboman.Core\Hoboman.Core.csproj" />
    <ProjectReference Include="..\..\src\Hoboman\Hoboman.csproj" />
  </ItemGroup>

  <!-- The CLI's own build holds all it needs, which the tests' folder does not, as the shared framework of ASP.NET Core leaves some of it out. -->
  <Target Name="WriteCliBuildFolder" AfterTargets="Build">
    <MSBuild Projects="..\..\src\Hoboman.Cli\Hoboman.Cli.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" PropertyName="CliTargetPath" />
    </MSBuild>
    <WriteLinesToFile File="$(OutDir)cli-build.txt" Lines="$([System.IO.Path]::GetDirectoryName($(CliTargetPath)))" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

</Project>
