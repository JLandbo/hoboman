<UserControl x:Class="Hoboman.Views.RequestBodyEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Hoboman.Controls"
             xmlns:viewModels="clr-namespace:Hoboman.ViewModels"
             xmlns:requests="clr-namespace:Hoboman.Core.Requests;assembly=Hoboman.Core">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Border Style="{StaticResource SegmentGroup}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="{DynamicResource Body.None}" GroupName="BodyKind" Style="{StaticResource Segment}"
                                     IsChecked="{Binding BodyKind, Converter={StaticResource IsEqual}, ConverterParameter={x:Static requests:BodyKind.None}}" />
                        <RadioButton Content="{DynamicResource Body.Json}" GroupName="BodyKind" Style="{StaticResource Segment}"
                                     IsChecked="{Binding BodyKind, Converter={StaticResource IsEqual}, ConverterParameter={x:Static requests:BodyKind.Json}}" />
                        <RadioButton Content="{DynamicResource Body.Xml}" GroupName="BodyKind" Style="{StaticResource Segment}"
                                     IsChecked="{Binding BodyKind, Converter={StaticResource IsEqual}, ConverterParameter={x:Static requests:BodyKind.Xml}}" />
                        <RadioButton Content="{DynamicResource Body.Text}" GroupName="BodyKind" Style="{StaticResource Segment}"
                                     IsChecked="{Binding BodyKind, Converter={StaticResource IsEqual}, ConverterParameter={x:Static requests:BodyKind.Text}}" />
                    </StackPanel>
                </Border>
                <Button ToolTip="{DynamicResource Body.FormatTip}" Click="Format_Click" FontSize="12" Padding="10,3" Margin="8,0,0,0" VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PillButton}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BodyKind}" Value="{x:Static requests:BodyKind.Json}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding BodyKind}" Value="{x:Static requests:BodyKind.Xml}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE943;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{DynamicResource Body.Format}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                <WrapPanel.Style>
                    <Style TargetType="WrapPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BodyKind}" Value="{x:Static requests:BodyKind.None}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </WrapPanel.Style>
                <ToggleButton Content="{DynamicResource Body.UseEnvironmentVariables}" IsChecked="{Binding UseEnvironmentVariablesInBody}" Style="{StaticResource Switch}" Margin="12,0,0,0" />
                <ToggleButton Content="{DynamicResource Base64.WholeBody}" IsChecked="{Binding Base64.EncodesWholeBody}" Style="{StaticResource Switch}" Margin="12,0,0,0" />
            </WrapPanel>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding BodyLayoutProblem}" Foreground="{DynamicResource Error}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding BodyLayoutProblem}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <Border CornerRadius="8" Background="{DynamicResource Input}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding BodyKind}" Value="{x:Static requests:BodyKind.None}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <controls:BodyEditor x:Name="BodyText" Body="{Binding Body}" UseEnvironmentVariables="{Binding UseEnvironmentVariablesInBody}" PreviewKeyDown="Body_PreviewKeyDown" Marks="{Binding Base64.BodyMarks}" MarksAreCurrent="{Binding Base64.BodyMarksAreCurrent}" MarkToggled="Body_MarkToggled">
                <controls:BodyEditor.Style>
                    <Style TargetType="controls:BodyEditor" BasedOn="{StaticResource {x:Type controls:BodyEditor}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BodyKind}" Value="{x:Static requests:BodyKind.Json}">
                                <Setter Property="Coloring" Value="{x:Static viewModels:BodyFormat.Json}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding BodyKind}" Value="{x:Static requests:BodyKind.Xml}">
                                <Setter Property="Coloring" Value="{x:Static viewModels:BodyFormat.Xml}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:BodyEditor.Style>
            </controls:BodyEditor>
        </Border>
    </DockPanel>
</UserControl>
