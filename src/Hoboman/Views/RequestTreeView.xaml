<UserControl x:Class="Hoboman.Views.RequestTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Hoboman.ViewModels">
    <Border Style="{StaticResource Panel}">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Tree.Title}" FontWeight="SemiBold" Margin="4,0,0,8" />
            <Grid>
                <TreeView ItemsSource="{Binding Nodes}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type viewModels:RequestNodeViewModel}" ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Name}" />
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                <TextBlock Text="{DynamicResource Tree.Empty}" Foreground="{DynamicResource Muted}" Margin="4,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Nodes.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
