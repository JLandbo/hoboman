<UserControl x:Class="Hoboman.Views.RequestTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Hoboman.ViewModels">
    <UserControl.Resources>
        <ContextMenu x:Key="RequestMenu" x:Shared="False" Style="{StaticResource PopupMenu}">
            <MenuItem Header="{DynamicResource Tree.Rename}" Click="Rename_Click" />
            <MenuItem Header="{DynamicResource Tree.Clone}" Click="Clone_Click" />
            <MenuItem Header="{DynamicResource Tree.Delete}" Click="Delete_Click" />
        </ContextMenu>
        <ContextMenu x:Key="DraftMenu" x:Shared="False" Style="{StaticResource PopupMenu}">
            <MenuItem Header="{DynamicResource Tree.Rename}" Click="Rename_Click" />
            <MenuItem Header="{DynamicResource Tree.Clone}" Click="Clone_Click" />
        </ContextMenu>
        <ContextMenu x:Key="FolderMenu" x:Shared="False" Style="{StaticResource PopupMenu}">
            <MenuItem Header="{DynamicResource Tree.FolderAuth}" Click="FolderAuth_Click" />
            <MenuItem Header="{DynamicResource Tree.Rename}" Click="RenameFolder_Click" />
            <MenuItem Header="{DynamicResource Tree.Delete}" Click="DeleteFolder_Click" />
        </ContextMenu>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Border x:Name="RootDropTarget" Background="{DynamicResource Box}" CornerRadius="6" Padding="8,6" Margin="2,2,2,6" Visibility="Collapsed" AllowDrop="True"
                DragEnter="Tree_DragOver" DragOver="Tree_DragOver" DragLeave="Tree_DragLeave" Drop="Tree_Drop">
            <TextBlock Text="{DynamicResource Tree.Root}" Foreground="{DynamicResource Muted}" />
        </Border>
        <TreeView x:Name="Tree" Grid.Row="1" ItemsSource="{Binding Tree.Nodes}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" AllowDrop="True"
                  PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="Tree_PreviewMouseLeftButtonUp" MouseMove="Tree_MouseMove" DragEnter="Tree_DragOver" DragOver="Tree_DragOver" DragLeave="Tree_DragLeave" Drop="Tree_Drop">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem" BasedOn="{StaticResource TreeItem}">
                    <EventSetter Event="MouseLeftButtonUp" Handler="Item_MouseLeftButtonUp" />
                    <EventSetter Event="KeyDown" Handler="Item_KeyDown" />
                    <Setter Property="ContextMenu" Value="{StaticResource FolderMenu}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFolder}" Value="False">
                            <Setter Property="ContextMenu" Value="{StaticResource RequestMenu}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDraft}" Value="True">
                            <Setter Property="ContextMenu" Value="{StaticResource DraftMenu}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type viewModels:RequestNodeViewModel}" ItemsSource="{Binding Children}">
                    <DockPanel>
                        <TextBlock x:Name="Chevron" DockPanel.Dock="Left" Width="18" Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                   Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Visibility="Collapsed" />
                        <TextBlock x:Name="Method" DockPanel.Dock="Left" Width="58" Text="{Binding Tab.Editor.Method}" FontSize="11" FontWeight="Bold"
                                   Foreground="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource MethodBrush}}" VerticalAlignment="Center" />
                        <Button x:Name="NewRequest" DockPanel.Dock="Right" Content="&#xE710;" Click="NewRequest_Click" Style="{StaticResource SmallIconButton}"
                                ToolTip="{DynamicResource Sidebar.NewRequest}" AutomationProperties.Name="{DynamicResource Sidebar.NewRequest}" VerticalAlignment="Center" Visibility="Collapsed" />
                        <Button x:Name="NewFolder" DockPanel.Dock="Right" Content="&#xE8F4;" Click="NewFolder_Click" Style="{StaticResource SmallIconButton}" Margin="0,0,4,0"
                                ToolTip="{DynamicResource Sidebar.NewFolder}" AutomationProperties.Name="{DynamicResource Sidebar.NewFolder}" VerticalAlignment="Center" Visibility="Collapsed" />
                        <Ellipse x:Name="Unsaved" DockPanel.Dock="Right" Width="7" Height="7" Fill="{DynamicResource Attention}" Margin="6,0,0,0" Visibility="Collapsed" />
                        <TextBlock x:Name="Label" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                    <HierarchicalDataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsFolder}" Value="True">
                            <Setter TargetName="Chevron" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Method" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="NewRequest" Property="Visibility" Value="Visible" />
                            <Setter TargetName="NewFolder" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tab}" Value="{x:Null}">
                            <Setter TargetName="Method" Property="Text" Value="{Binding Method}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDraft}" Value="True">
                            <Setter TargetName="Label" Property="Text" Value="{Binding Tab.Title}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tab.IsUnsaved}" Value="True">
                            <Setter TargetName="Unsaved" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsFolder}" Value="True" />
                                <Condition Binding="{Binding IsExpanded}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" />
                        </MultiDataTrigger>
                    </HierarchicalDataTemplate.Triggers>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
        <TextBlock Grid.Row="1" Text="{DynamicResource Tree.Empty}" Foreground="{DynamicResource Muted}" Margin="8,4,0,0" IsHitTestVisible="False">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Tree.Nodes.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
