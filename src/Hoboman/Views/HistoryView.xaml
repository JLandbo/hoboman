<UserControl x:Class="Hoboman.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:Hoboman.Themes"
             xmlns:viewModels="clr-namespace:Hoboman.ViewModels">
    <Grid>
        <ListBox x:Name="Entries" ItemsSource="{Binding History.Items}" Style="{StaticResource SideList}" MouseLeftButtonUp="Entries_MouseLeftButtonUp" KeyDown="Entries_KeyDown">
            <!-- The history has many calls, so its rows are only as high as their remove button. -->
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource SideListItem}">
                    <Setter Property="Padding" Value="8,0" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Muted}" FontSize="11" FontWeight="SemiBold" Margin="8,10,0,4" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type viewModels:HistoryItemViewModel}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="&#xE711;" ToolTip="{DynamicResource History.Delete}" Click="Delete_Click" Style="{StaticResource CloseButton}" Margin="4,0,0,0" VerticalAlignment="Center" />
                        <Border x:Name="Status" DockPanel.Dock="Right" Style="{StaticResource SmallStatusPill}" Tag="{Binding IsSuccess}" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StatusText" Text="{Binding Status}" />
                        </Border>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                        <Border x:Name="Cli" DockPanel.Dock="Right" CornerRadius="4" Padding="5,1" Background="{DynamicResource Button}" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Text="{DynamicResource History.Cli}" Foreground="{DynamicResource Muted}" FontSize="10" />
                        </Border>
                        <TextBlock DockPanel.Dock="Left" Width="58" Text="{Binding Method}" FontSize="11" FontWeight="Bold"
                                   themes:MethodColor.Of="{Binding Method}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Address}" FontFamily="{StaticResource CodeFont}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="{x:Null}">
                            <Setter TargetName="StatusText" Property="Text" Value="{DynamicResource History.Failed}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCli}" Value="True">
                            <Setter TargetName="Cli" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="{DynamicResource History.Empty}" Foreground="{DynamicResource Muted}" Margin="8,4,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding History.Items.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
