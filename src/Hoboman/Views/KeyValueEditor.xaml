<UserControl x:Class="Hoboman.Views.KeyValueEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hoboman.Views"
             xmlns:controls="clr-namespace:Hoboman.Controls"
             xmlns:viewModels="clr-namespace:Hoboman.ViewModels">
    <Border CornerRadius="8" Background="{DynamicResource Box}" BorderBrush="{DynamicResource BoxEdge}" BorderThickness="1">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="8,6,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="{Binding NameHeader, RelativeSource={RelativeSource AncestorType=local:KeyValueEditor}}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="4,0" />
                <TextBlock Grid.Column="2" Text="{Binding ValueHeader, RelativeSource={RelativeSource AncestorType=local:KeyValueEditor}}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="4,0" />
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:KeyValueRowViewModel}">
                            <Border BorderBrush="{DynamicResource BoxEdge}" BorderThickness="0,1,0,0" Padding="8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="28" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="Enabled" IsChecked="{Binding Enabled}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="Placeholder" Grid.Column="1" Text="{DynamicResource Table.Add}" Foreground="{DynamicResource Muted}" FontSize="12"
                                               Margin="6,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                    <controls:VariableTextBox x:Name="NameBox" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Padding="4,6" />
                                    <controls:VariableTextBox x:Name="ValueBox" Grid.Column="2" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Padding="4,6" />
                                    <Button x:Name="Remove" Grid.Column="3" Content="&#xE711;" ToolTip="{DynamicResource Table.Remove}" Click="Remove_Click" Style="{StaticResource CloseButton}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsBlank}" Value="True">
                                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Enabled" Property="Visibility" Value="Hidden" />
                                    <Setter TargetName="Remove" Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                    <Setter TargetName="NameBox" Property="Opacity" Value="0.5" />
                                    <Setter TargetName="ValueBox" Property="Opacity" Value="0.5" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CanDisable, RelativeSource={RelativeSource AncestorType=local:KeyValueEditor}}" Value="False">
                                    <Setter TargetName="Enabled" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
