<local:DialogWindow x:Class="Hoboman.Views.ValuesDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Hoboman.Views"
                    xmlns:viewModels="clr-namespace:Hoboman.ViewModels"
                    Width="460" SizeToContent="Height">
    <StackPanel>
        <ItemsControl x:Name="Fields" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type viewModels:KeyValueRowViewModel}">
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource Label}" />
                        <Border CornerRadius="8" Background="{DynamicResource Input}">
                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Cell}" Padding="8,6" />
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="{DynamicResource Common.Cancel}" Command="{x:Static SystemCommands.CloseWindowCommand}" Style="{StaticResource PillButton}" Margin="0,0,8,0" />
            <Button x:Name="ConfirmButton" Click="Confirm_Click" IsDefault="True" Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </StackPanel>
</local:DialogWindow>
