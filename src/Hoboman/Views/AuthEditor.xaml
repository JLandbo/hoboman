<UserControl x:Class="Hoboman.Views.AuthEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:auth="clr-namespace:Hoboman.Core.Auth;assembly=Hoboman.Core">
    <UserControl.Resources>
        <Style x:Key="OnlyForAuthorizationCode" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Grant}" Value="{x:Static auth:OAuthGrant.AuthorizationCode}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource SegmentGroup}" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="{DynamicResource Auth.Inherit}" GroupName="AuthKind" Style="{StaticResource Segment}"
                             IsChecked="{Binding Kind, Converter={StaticResource IsEqual}, ConverterParameter={x:Static auth:AuthKind.Inherit}}" />
                <RadioButton Content="{DynamicResource Auth.None}" GroupName="AuthKind" Style="{StaticResource Segment}"
                             IsChecked="{Binding Kind, Converter={StaticResource IsEqual}, ConverterParameter={x:Static auth:AuthKind.None}}" />
                <RadioButton Content="{DynamicResource Auth.Basic}" GroupName="AuthKind" Style="{StaticResource Segment}"
                             IsChecked="{Binding Kind, Converter={StaticResource IsEqual}, ConverterParameter={x:Static auth:AuthKind.Basic}}" />
                <RadioButton Content="{DynamicResource Auth.Bearer}" GroupName="AuthKind" Style="{StaticResource Segment}"
                             IsChecked="{Binding Kind, Converter={StaticResource IsEqual}, ConverterParameter={x:Static auth:AuthKind.Bearer}}" />
                <RadioButton Content="{DynamicResource Auth.OAuth2}" GroupName="AuthKind" Style="{StaticResource Segment}"
                             IsChecked="{Binding Kind, Converter={StaticResource IsEqual}, ConverterParameter={x:Static auth:AuthKind.OAuth2}}" />
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel HorizontalAlignment="Left" Width="420">
                <TextBlock Text="{DynamicResource Auth.InheritHint}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static auth:AuthKind.Inherit}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static auth:AuthKind.Basic}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{DynamicResource Auth.UserName}" Style="{StaticResource Label}" />
                    <Border CornerRadius="8" Background="{DynamicResource Input}" Margin="0,0,0,10">
                        <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Cell}" Padding="8,6" />
                    </Border>
                    <TextBlock Text="{DynamicResource Auth.Password}" Style="{StaticResource Label}" />
                    <Border CornerRadius="8" Background="{DynamicResource Input}">
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordCell}" PasswordChanged="PasswordBox_PasswordChanged" />
                    </Border>
                </StackPanel>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static auth:AuthKind.Bearer}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{DynamicResource Auth.Token}" Style="{StaticResource Label}" />
                    <Border CornerRadius="8" Background="{DynamicResource Input}">
                        <TextBox Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Cell}" Padding="8,6" />
                    </Border>
                </StackPanel>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="{x:Static auth:AuthKind.OAuth2}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="{DynamicResource OAuth.ClientCredentials}" GroupName="OAuthGrant" Style="{StaticResource Segment}"
                                         IsChecked="{Binding Grant, Converter={StaticResource IsEqual}, ConverterParameter={x:Static auth:OAuthGrant.ClientCredentials}}" />
                            <RadioButton Content="{DynamicResource OAuth.AuthorizationCode}" GroupName="OAuthGrant" Style="{StaticResource Segment}"
                                         IsChecked="{Binding Grant, Converter={StaticResource IsEqual}, ConverterParameter={x:Static auth:OAuthGrant.AuthorizationCode}}" />
                        </StackPanel>
                    </Border>
                    <!-- The fetch comes first, because the fields below it can be taller than the space the auth gets. -->
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Left" Content="{DynamicResource OAuth.Fetch}" Command="{Binding FetchToken}" Style="{StaticResource PillButton}" />
                        <Button DockPanel.Dock="Left" Content="{DynamicResource Common.Cancel}" Click="CancelFetch_Click" Style="{StaticResource PillButton}" Margin="8,0,0,0"
                                Visibility="{Binding IsFetching, Converter={StaticResource VisibleWhenTrue}}" />
                        <TextBlock Foreground="{DynamicResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding TokenStatus}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFetching}" Value="True">
                                            <Setter Property="Text" Value="{DynamicResource OAuth.Fetching}" />
                                        </DataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsFetching}" Value="True" />
                                                <Condition Binding="{Binding Grant}" Value="{x:Static auth:OAuthGrant.AuthorizationCode}" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Text" Value="{DynamicResource OAuth.Waiting}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DockPanel>
                    <TextBlock Text="{Binding TokenProblem}" Foreground="{DynamicResource Error}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TokenProblem}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Style="{StaticResource OnlyForAuthorizationCode}">
                        <TextBlock Text="{DynamicResource OAuth.AuthorizeUrl}" Style="{StaticResource Label}" />
                        <Border CornerRadius="8" Background="{DynamicResource Input}" Margin="0,0,0,10">
                            <TextBox Text="{Binding AuthorizeUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Cell}" Padding="8,6" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource OAuth.TokenUrl}" Style="{StaticResource Label}" />
                    <Border CornerRadius="8" Background="{DynamicResource Input}" Margin="0,0,0,10">
                        <TextBox Text="{Binding TokenUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Cell}" Padding="8,6" />
                    </Border>
                    <TextBlock Text="{DynamicResource OAuth.ClientId}" Style="{StaticResource Label}" />
                    <Border CornerRadius="8" Background="{DynamicResource Input}" Margin="0,0,0,10">
                        <TextBox Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Cell}" Padding="8,6" />
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource OAuth.ClientSecret}" Style="{StaticResource Label}" />
                        <Border Style="{StaticResource OnlyForAuthorizationCode}" Margin="4,0,0,0">
                            <TextBlock Text="{DynamicResource OAuth.Optional}" Style="{StaticResource Label}" />
                        </Border>
                    </StackPanel>
                    <Border CornerRadius="8" Background="{DynamicResource Input}" Margin="0,0,0,10">
                        <PasswordBox x:Name="ClientSecretBox" Style="{StaticResource PasswordCell}" PasswordChanged="ClientSecretBox_PasswordChanged" />
                    </Border>
                    <TextBlock Text="{DynamicResource OAuth.Scope}" Style="{StaticResource Label}" />
                    <Border CornerRadius="8" Background="{DynamicResource Input}" Margin="0,0,0,10">
                        <TextBox Text="{Binding Scope, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Cell}" Padding="8,6" />
                    </Border>
                    <TextBlock Text="{DynamicResource OAuth.ClientAuthentication}" Style="{StaticResource Label}" />
                    <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="{DynamicResource OAuth.BasicHeader}" GroupName="ClientAuthentication" Style="{StaticResource Segment}"
                                         IsChecked="{Binding ClientAuthentication, Converter={StaticResource IsEqual}, ConverterParameter={x:Static auth:OAuthClientAuthentication.BasicHeader}}" />
                            <RadioButton Content="{DynamicResource OAuth.RequestBody}" GroupName="ClientAuthentication" Style="{StaticResource Segment}"
                                         IsChecked="{Binding ClientAuthentication, Converter={StaticResource IsEqual}, ConverterParameter={x:Static auth:OAuthClientAuthentication.RequestBody}}" />
                        </StackPanel>
                    </Border>
                    <StackPanel Style="{StaticResource OnlyForAuthorizationCode}">
                        <TextBlock Text="{DynamicResource OAuth.RedirectPort}" Style="{StaticResource Label}" />
                        <Border CornerRadius="8" Background="{DynamicResource Input}" Width="120" HorizontalAlignment="Left">
                            <TextBox Text="{Binding RedirectPort, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Style="{StaticResource Cell}" Padding="8,6" />
                        </Border>
                        <TextBlock Text="{DynamicResource OAuth.RedirectHint}" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
