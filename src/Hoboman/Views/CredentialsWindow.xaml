<local:DialogWindow x:Class="Hoboman.Views.CredentialsWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Hoboman.Views"
                    xmlns:viewModels="clr-namespace:Hoboman.ViewModels"
                    Title="{DynamicResource Credentials.Title}" Width="1060" Height="660">
    <DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{DynamicResource Common.Close}" Command="{x:Static SystemCommands.CloseWindowCommand}" Style="{StaticResource PillButton}" Margin="0,0,8,0" />
                <Button Content="{DynamicResource Common.Save}" Click="Save_Click" IsDefault="True" IsEnabled="{Binding CanSave}" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
            <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource Error}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border CornerRadius="8" Background="{DynamicResource Box}" BorderBrush="{DynamicResource BoxEdge}" BorderThickness="1" Padding="4">
                <Grid>
                    <ListBox ItemsSource="{Binding Environments}" SelectedItem="{Binding SelectedEnvironment}" Style="{StaticResource SideList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:CredentialGroupViewModel}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Drafts.Count}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Environment.Name}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{DynamicResource Environments.Empty}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="8,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Environments.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
            <Border Grid.Column="2" CornerRadius="8" Background="{DynamicResource Box}" BorderBrush="{DynamicResource BoxEdge}" BorderThickness="1" Padding="6">
                <DockPanel>
                    <Border DockPanel.Dock="Top" CornerRadius="8" Background="{DynamicResource Input}" Margin="0,0,0,4">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Cell}" FontFamily="{StaticResource UiFont}" Padding="8,6" />
                        </DockPanel>
                    </Border>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="&#xE710;" ToolTip="{DynamicResource Credentials.Add}" AutomationProperties.Name="{DynamicResource Credentials.Add}" Click="Add_Click" Style="{StaticResource SmallIconButton}" FontSize="12" />
                        <Button Content="&#xE738;" ToolTip="{DynamicResource Credentials.Remove}" AutomationProperties.Name="{DynamicResource Credentials.Remove}" Click="Remove_Click" Style="{StaticResource SmallIconButton}" FontSize="12" Margin="4,0,0,0" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Shown}" SelectedItem="{Binding Selected}" Style="{StaticResource SideList}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:CredentialDraftViewModel}">
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" CornerRadius="6" Padding="6,0" Background="{DynamicResource Card}" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource KindBadge}" Tag="{Binding Auth.Kind}" />
                                    </Border>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <DockPanel Grid.Column="4" DataContext="{Binding Selected}">
                <DockPanel.Style>
                    <Style TargetType="DockPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DockPanel.Style>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{DynamicResource Common.Name}" Style="{StaticResource Label}" />
                    <Border CornerRadius="8" Background="{DynamicResource Input}" Margin="0,0,0,10">
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Cell}" FontFamily="{StaticResource UiFont}" Padding="8,6"
                                 AutomationProperties.Name="{DynamicResource Common.Name}" />
                    </Border>
                </StackPanel>
                <local:AuthEditor DataContext="{Binding Auth}" CanInherit="False" IsCredential="True"
                                  Clipboard="{Binding DataContext.Clipboard, RelativeSource={RelativeSource AncestorType=Window}}" />
            </DockPanel>
        </Grid>
    </DockPanel>
</local:DialogWindow>
