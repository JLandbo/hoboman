<UserControl x:Class="Hoboman.Views.RequestEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hoboman.Views"
             xmlns:controls="clr-namespace:Hoboman.Controls"
             xmlns:viewModels="clr-namespace:Hoboman.ViewModels"
             xmlns:requests="clr-namespace:Hoboman.Core.Requests;assembly=Hoboman.Core"
             xmlns:auth="clr-namespace:Hoboman.Core.Auth;assembly=Hoboman.Core">
    <UserControl.Resources>
        <Style x:Key="Count" TargetType="TextBlock">
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Opacity" Value="0.7" />
            <Style.Triggers>
                <Trigger Property="Text" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource Panel}">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Content="{DynamicResource Editor.Save}" Command="{Binding Save}" Style="{StaticResource PillButton}" FontSize="12" Padding="12,4" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Folder}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,6,0" />
                    <TextBlock Text="{DynamicResource History.FromHistory}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,6,0"
                               Visibility="{Binding FromHistory, Converter={StaticResource VisibleWhenTrue}}" />
                    <TextBlock FontSize="12" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding Title}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Title}" Value="{x:Null}">
                                        <Setter Property="Text" Value="{DynamicResource Tab.New}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </DockPanel>

            <DockPanel DockPanel.Dock="Top">
                <Grid DockPanel.Dock="Right" Margin="8,0,0,0">
                    <Button Content="{DynamicResource Editor.Send}" Command="{Binding Send}" Padding="18,6">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSending}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{DynamicResource Common.Cancel}" Command="{Binding Cancel}" Style="{StaticResource PillButton}" Padding="18,6"
                            Visibility="{Binding IsSending, Converter={StaticResource VisibleWhenTrue}}" />
                </Grid>
                <ToggleButton x:Name="MethodToggle" DockPanel.Dock="Left" Style="{StaticResource PillToggle}" Margin="0,0,8,0" MinWidth="96"
                              IsHitTestVisible="{Binding IsOpen, ElementName=MethodPopup, Converter={StaticResource Not}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Method}" Foreground="{Binding Method, Converter={StaticResource MethodBrush}}" FontWeight="Bold" />
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Foreground="{DynamicResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </ToggleButton>
                <Popup x:Name="MethodPopup" IsOpen="{Binding IsChecked, ElementName=MethodToggle}" PlacementTarget="{Binding ElementName=MethodToggle}"
                       StaysOpen="False" AllowsTransparency="True" Opened="MethodPopup_Opened">
                    <Border Style="{StaticResource Menu}" Width="220">
                        <StackPanel>
                            <ItemsControl ItemsSource="{x:Static viewModels:RequestTabViewModel.Methods}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource MenuButton}" Click="Method_Click" HorizontalAlignment="Stretch">
                                            <TextBlock Text="{Binding}" Foreground="{Binding Converter={StaticResource MethodBrush}}" FontWeight="Bold" FontSize="12" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border BorderBrush="{DynamicResource BoxEdge}" BorderThickness="0,1,0,0" Margin="0,6,0,6" />
                            <Grid>
                                <TextBlock x:Name="CustomPlaceholder" Text="{DynamicResource Editor.CustomMethod}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="10,0" VerticalAlignment="Center" />
                                <TextBox x:Name="CustomMethod" Style="{StaticResource Cell}" Margin="6,0" KeyDown="CustomMethod_KeyDown" TextChanged="CustomMethod_TextChanged" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Popup>
                <controls:VariableTextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,12,0,8">
                <RadioButton x:Name="ParamsSection" GroupName="RequestSection" IsChecked="True" Style="{StaticResource Segment}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Editor.Params}" />
                        <TextBlock Text="{Binding Query.Count}" Style="{StaticResource Count}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="HeadersSection" GroupName="RequestSection" Style="{StaticResource Segment}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Editor.Headers}" />
                        <TextBlock Text="{Binding Headers.Count}" Style="{StaticResource Count}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="BodySection" Content="{DynamicResource Editor.Body}" GroupName="RequestSection" Style="{StaticResource Segment}" />
                <RadioButton x:Name="AuthSection" Content="{DynamicResource Editor.Auth}" GroupName="RequestSection" Style="{StaticResource Segment}" />
            </StackPanel>

            <Grid>
                <local:KeyValueEditor DataContext="{Binding Query}" Visibility="{Binding IsChecked, ElementName=ParamsSection, Converter={StaticResource VisibleWhenTrue}}" />
                <local:KeyValueEditor DataContext="{Binding Headers}" Visibility="{Binding IsChecked, ElementName=HeadersSection, Converter={StaticResource VisibleWhenTrue}}" />

                <DockPanel Visibility="{Binding IsChecked, ElementName=BodySection, Converter={StaticResource VisibleWhenTrue}}">
                    <Border DockPanel.Dock="Top" HorizontalAlignment="Left" Padding="2" CornerRadius="8" Background="{DynamicResource Input}" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="{DynamicResource Body.None}" GroupName="BodyKind" Style="{StaticResource Segment}"
                                         IsChecked="{Binding BodyKind, Converter={StaticResource IsEqual}, ConverterParameter={x:Static requests:BodyKind.None}}" />
                            <RadioButton Content="{DynamicResource Body.Json}" GroupName="BodyKind" Style="{StaticResource Segment}"
                                         IsChecked="{Binding BodyKind, Converter={StaticResource IsEqual}, ConverterParameter={x:Static requests:BodyKind.Json}}" />
                            <RadioButton Content="{DynamicResource Body.Text}" GroupName="BodyKind" Style="{StaticResource Segment}"
                                         IsChecked="{Binding BodyKind, Converter={StaticResource IsEqual}, ConverterParameter={x:Static requests:BodyKind.Text}}" />
                        </StackPanel>
                    </Border>
                    <TextBox Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource Code}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding BodyKind}" Value="{x:Static requests:BodyKind.None}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </DockPanel>

                <DockPanel Visibility="{Binding IsChecked, ElementName=AuthSection, Converter={StaticResource VisibleWhenTrue}}">
                    <Border DockPanel.Dock="Top" HorizontalAlignment="Left" Padding="2" CornerRadius="8" Background="{DynamicResource Input}" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="{DynamicResource Auth.None}" GroupName="AuthKind" Style="{StaticResource Segment}"
                                         IsChecked="{Binding AuthKind, Converter={StaticResource IsEqual}, ConverterParameter={x:Static auth:AuthKind.None}}" />
                            <RadioButton Content="{DynamicResource Auth.Basic}" GroupName="AuthKind" Style="{StaticResource Segment}"
                                         IsChecked="{Binding AuthKind, Converter={StaticResource IsEqual}, ConverterParameter={x:Static auth:AuthKind.Basic}}" />
                            <RadioButton Content="{DynamicResource Auth.Bearer}" GroupName="AuthKind" Style="{StaticResource Segment}"
                                         IsChecked="{Binding AuthKind, Converter={StaticResource IsEqual}, ConverterParameter={x:Static auth:AuthKind.Bearer}}" />
                        </StackPanel>
                    </Border>
                    <StackPanel HorizontalAlignment="Left" Width="420">
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AuthKind}" Value="{x:Static auth:AuthKind.Basic}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{DynamicResource Auth.UserName}" Style="{StaticResource Label}" />
                            <Border CornerRadius="8" Background="{DynamicResource Input}" Margin="0,0,0,10">
                                <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Cell}" Padding="8,6" />
                            </Border>
                            <TextBlock Text="{DynamicResource Auth.Password}" Style="{StaticResource Label}" />
                            <Border CornerRadius="8" Background="{DynamicResource Input}">
                                <PasswordBox x:Name="PasswordBox" Style="{StaticResource Field}" Background="Transparent" Padding="8,6" CaretBrush="{DynamicResource Text}"
                                             PasswordChanged="PasswordBox_PasswordChanged" />
                            </Border>
                        </StackPanel>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AuthKind}" Value="{x:Static auth:AuthKind.Bearer}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{DynamicResource Auth.Token}" Style="{StaticResource Label}" />
                            <Border CornerRadius="8" Background="{DynamicResource Input}">
                                <TextBox Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Cell}" Padding="8,6" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
