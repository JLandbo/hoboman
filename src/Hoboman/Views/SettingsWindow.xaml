<local:DialogWindow x:Class="Hoboman.Views.SettingsWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Hoboman.Views"
                    xmlns:themes="clr-namespace:Hoboman.Themes"
                    Title="{DynamicResource Settings.Title}" Width="440" SizeToContent="Height">
    <StackPanel>
        <DockPanel Margin="0,0,0,16">
            <ListBox DockPanel.Dock="Right" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" DisplayMemberPath="Name" Style="{StaticResource Segments}" />
            <TextBlock Text="{DynamicResource Settings.Language}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
        </DockPanel>
        <DockPanel Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Content="&#xE838;" ToolTip="{DynamicResource Settings.OpenThemes}" AutomationProperties.Name="{DynamicResource Settings.OpenThemes}"
                    Click="OpenThemes_Click" Style="{StaticResource SmallIconButton}" FontSize="12" VerticalAlignment="Center" />
            <TextBlock Text="{DynamicResource Settings.Theme}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
        </DockPanel>
        <ItemsControl ItemsSource="{Binding Themes}" Focusable="False" Margin="0,0,0,8">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type themes:ThemeChoice}">
                    <Border x:Name="Tile" Margin="0,0,8,8" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent">
                        <Button Click="Theme_Click" Style="{StaticResource PillButton}" Padding="10,8" AutomationProperties.Name="{Binding Name}">
                            <StackPanel>
                                <Border Width="80" Height="48" CornerRadius="6" Padding="8" Background="{Binding Surface}" BorderBrush="{Binding Edge}" BorderThickness="1">
                                    <Grid>
                                        <StackPanel>
                                            <Border Width="44" Height="5" CornerRadius="2.5" Background="{Binding Text}" HorizontalAlignment="Left" />
                                            <Border Width="30" Height="5" CornerRadius="2.5" Background="{Binding Muted}" HorizontalAlignment="Left" Margin="0,5,0,0" />
                                        </StackPanel>
                                        <Border Width="22" Height="9" CornerRadius="4.5" Background="{Binding Attention}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" FontSize="12" Margin="0,4,0,0" />
                            </StackPanel>
                        </Button>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Selected}" Value="True">
                            <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Attention}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <CheckBox Content="{DynamicResource Settings.IgnoreCertificateErrors}" IsChecked="{Binding IgnoreCertificateErrors}" />
        <DockPanel Margin="0,12,0,0">
            <TextBlock Text="{DynamicResource Settings.DeleteHistory}" VerticalAlignment="Center" />
            <Border CornerRadius="8" Background="{DynamicResource Input}" Width="56" Margin="8,0" VerticalAlignment="Center">
                <TextBox x:Name="DeleteHistoryDays" Text="{Binding DeleteHistoryAfterDays, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Cell}"
                         FontFamily="{StaticResource UiFont}" Padding="8,4" HorizontalContentAlignment="Right" AutomationProperties.Name="{DynamicResource Settings.DeleteHistory}" />
            </Border>
            <TextBlock Text="{DynamicResource Settings.Days}" VerticalAlignment="Center" />
        </DockPanel>
        <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource Error}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Problem}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <Border Background="{DynamicResource Box}" BorderBrush="{DynamicResource BoxEdge}" BorderThickness="1" CornerRadius="8" Padding="12,10,12,4" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="{DynamicResource Shortcuts.Title}" Foreground="{DynamicResource Muted}" Margin="0,0,0,8" />
                <Grid>
                    <Grid.Resources>
                        <Style x:Key="Keys" TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Button}" />
                            <Setter Property="CornerRadius" Value="4" />
                            <Setter Property="Padding" Value="6,1" />
                            <Setter Property="Margin" Value="0,0,12,6" />
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Setter Property="VerticalAlignment" Value="Top" />
                        </Style>
                        <Style x:Key="What" TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="Margin" Value="0,1,0,6" />
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Keys}">
                        <TextBlock Text="{DynamicResource Shortcuts.SendKeys}" FontFamily="{StaticResource CodeFont}" FontSize="12" />
                    </Border>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource Shortcuts.Send}" Style="{StaticResource What}" />
                    <Border Grid.Row="1" Style="{StaticResource Keys}">
                        <TextBlock Text="{DynamicResource Shortcuts.SaveKeys}" FontFamily="{StaticResource CodeFont}" FontSize="12" />
                    </Border>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{DynamicResource Shortcuts.Save}" Style="{StaticResource What}" />
                    <Border Grid.Row="2" Style="{StaticResource Keys}">
                        <TextBlock Text="{DynamicResource Shortcuts.FormatKeys}" FontFamily="{StaticResource CodeFont}" FontSize="12" />
                    </Border>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{DynamicResource Shortcuts.Format}" Style="{StaticResource What}" />
                    <Border Grid.Row="3" Style="{StaticResource Keys}">
                        <TextBlock Text="{DynamicResource Shortcuts.UndoKeys}" FontFamily="{StaticResource CodeFont}" FontSize="12" />
                    </Border>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{DynamicResource Shortcuts.Undo}" Style="{StaticResource What}" />
                    <Border Grid.Row="4" Style="{StaticResource Keys}">
                        <TextBlock Text="{DynamicResource Shortcuts.OpenKeys}" FontFamily="{StaticResource CodeFont}" FontSize="12" />
                    </Border>
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{DynamicResource Shortcuts.Open}" Style="{StaticResource What}" />
                    <Border Grid.Row="5" Style="{StaticResource Keys}">
                        <TextBlock Text="{DynamicResource Shortcuts.CloseKeys}" FontFamily="{StaticResource CodeFont}" FontSize="12" />
                    </Border>
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{DynamicResource Shortcuts.Close}" Style="{StaticResource What}" />
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</local:DialogWindow>
