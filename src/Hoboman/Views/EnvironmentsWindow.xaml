<Window x:Class="Hoboman.Views.EnvironmentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Hoboman.Views"
        xmlns:viewModels="clr-namespace:Hoboman.ViewModels"
        Title="{DynamicResource Environments.Title}" Width="820" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        Foreground="{DynamicResource Text}" FontFamily="{StaticResource UiFont}" FontSize="13">
    <Border Style="{StaticResource DialogPanel}" MouseLeftButtonDown="Border_MouseLeftButtonDown">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Content="&#xE711;" ToolTip="{DynamicResource Common.Close}" Click="Cancel_Click" IsCancel="True" Style="{StaticResource SmallIconButton}" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="{DynamicResource Environments.Title}" FontSize="18" FontWeight="SemiBold" />
            </DockPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="{DynamicResource Common.Cancel}" Click="Cancel_Click" Style="{StaticResource PillButton}" Margin="0,0,8,0" />
                    <Button Content="{DynamicResource Common.Save}" Click="Save_Click" IsDefault="True" IsEnabled="{Binding CanSave}" Style="{StaticResource PrimaryButton}" />
                </StackPanel>
                <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource Error}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
            </DockPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border CornerRadius="8" Background="{DynamicResource Box}" BorderBrush="{DynamicResource BoxEdge}" BorderThickness="1" Padding="4">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Content="&#xE710;" ToolTip="{DynamicResource Environments.Add}" Click="Add_Click" Style="{StaticResource SmallIconButton}" FontSize="12" />
                            <Button Content="&#xE738;" ToolTip="{DynamicResource Environments.Remove}" Click="Remove_Click" Style="{StaticResource SmallIconButton}" FontSize="12" Margin="4,0,0,0" />
                        </StackPanel>
                        <Grid>
                            <ListBox ItemsSource="{Binding Environments}" SelectedItem="{Binding Selected}" Style="{StaticResource SideList}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type viewModels:EnvironmentDraftViewModel}">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{DynamicResource Environments.Empty}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="8,6,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Environments.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                </Border>
                <DockPanel Grid.Column="2" DataContext="{Binding Selected}">
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{DynamicResource Common.Name}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,4" />
                        <Border CornerRadius="8" Background="{DynamicResource Input}" Margin="0,0,0,14">
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Cell}" Padding="8,6" />
                        </Border>
                        <TextBlock Text="{DynamicResource Environments.Variables}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,4" />
                    </StackPanel>
                    <local:KeyValueEditor DataContext="{Binding Variables}" />
                </DockPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
