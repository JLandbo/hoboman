<UserControl x:Class="Hoboman.Views.WorkflowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hoboman.Views"
             xmlns:controls="clr-namespace:Hoboman.Controls"
             xmlns:themes="clr-namespace:Hoboman.Themes"
             xmlns:scripts="clr-namespace:Hoboman.Core.Scripts;assembly=Hoboman.Core"
             xmlns:viewModels="clr-namespace:Hoboman.ViewModels">
    <UserControl.Resources>
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="0,1,4,1" />
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BoxEdge}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="SavedChip" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="Background" Value="{DynamicResource SuccessSoft}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource CodeFont}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="SavedChipText" TargetType="TextBlock" BasedOn="{StaticResource ChipText}">
            <Setter Property="Foreground" Value="{DynamicResource Success}" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Badge" TargetType="Border" BasedOn="{StaticResource SmallStatusPill}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- A step's tab that holds something says so in the accent colour, turned around on the chosen tab. -->
        <Style x:Key="UsedBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource Attention}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource OnAttention}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="UsedBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource OnAttention}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Attention}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
            <DockPanel>
                <Grid DockPanel.Dock="Right" Margin="8,0,0,0">
                    <Button Content="{DynamicResource Workflow.Run}" Command="{Binding Send}" Padding="18,6">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{DynamicResource Common.Cancel}" Click="Cancel_Click" Style="{StaticResource PillButton}" Padding="18,6"
                            Visibility="{Binding IsRunning, Converter={StaticResource VisibleWhenTrue}}" />
                </Grid>
                <Button DockPanel.Dock="Right" Content="{DynamicResource Editor.Save}" Command="{Binding Save}" Style="{StaticResource PillButton}" FontSize="12" Padding="12,4" VerticalAlignment="Center" />
                <Border DockPanel.Dock="Right" Tag="{Binding HasSucceeded}" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource StatusPill}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Summary}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Summary}" />
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Workflow.Crumb}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Attention}" Margin="6,0,0,0" VerticalAlignment="Center"
                             Visibility="{Binding IsDirty, Converter={StaticResource VisibleWhenTrue}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" Background="{DynamicResource ErrorSoft}" BorderBrush="{DynamicResource ErrorEdge}" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Problems.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xEA39;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Error}" Margin="0,2,10,0" />
                <StackPanel>
                    <TextBlock Text="{DynamicResource Workflow.CannotRun}" Foreground="{DynamicResource Error}" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Problems}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2" local:SplitMemory.Columns="WorkflowSteps">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="260" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Panel}">
                <DockPanel>
                    <!-- The parameters and the auth the steps inherit share one place, so the steps keep the room below. -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ParametersChoice" Content="{DynamicResource Workflow.Parameters}" GroupName="WorkflowSettings" IsChecked="True" Style="{StaticResource Segment}" />
                                <RadioButton x:Name="WorkflowAuthChoice" Content="{DynamicResource Workflow.Auth}" GroupName="WorkflowSettings" Style="{StaticResource Segment}" />
                                <Button x:Name="RefreshWorkflowAuthButton" Click="RefreshWorkflowAuth_Click" Style="{StaticResource RefreshAuthButton}" />
                            </StackPanel>
                        </Border>
                    </DockPanel>
                    <local:KeyValueEditor DockPanel.Dock="Top" DataContext="{Binding Parameters}" ValueHeader="{DynamicResource Workflow.Default}" CanDisable="False" MaxHeight="180" Margin="0,0,0,12" local:SplitMemory.Columns="Parameters"
                                          Visibility="{Binding IsChecked, ElementName=ParametersChoice, Converter={StaticResource VisibleWhenTrue}}">
                        <local:KeyValueEditor.Resources>
                            <!-- A default is a literal JSON value, not a reference to other names. -->
                            <Style TargetType="controls:VariableTextBox" BasedOn="{StaticResource Cell}" />
                        </local:KeyValueEditor.Resources>
                    </local:KeyValueEditor>
                    <local:AuthEditor DockPanel.Dock="Top" DataContext="{Binding Auth}" CanInherit="False" Margin="0,0,0,12"
                                      Visibility="{Binding IsChecked, ElementName=WorkflowAuthChoice, Converter={StaticResource VisibleWhenTrue}}" />
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" FontSize="12" Padding="10,3" Click="AddRequest_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{DynamicResource Workflow.AddRequest}" />
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" FontSize="12" Padding="10,3" Margin="0,0,6,0" Click="AddScript_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{DynamicResource Workflow.AddScript}" />
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource PillButton}" FontSize="12" Padding="10,3" Margin="0,0,6,0" Click="AddDelay_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{DynamicResource Workflow.AddDelay}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{DynamicResource Workflow.Steps}" Style="{StaticResource Heading}" />
                    </DockPanel>
                    <!-- A timeline: numbered circles joined by a line, as the steps run in this order. Only the step itself is marked when it is chosen, not its circle. -->
                    <!-- The steps differ in height, so the list scrolls by pixels instead of jumping a whole step at a time. -->
                    <ListBox x:Name="StepList" ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}" Style="{StaticResource SideList}" ScrollViewer.CanContentScroll="False">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource SideListItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:WorkflowStepViewModel}">
                                <Grid Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle x:Name="Line" Width="2" Fill="{DynamicResource BoxEdge}" HorizontalAlignment="Center" Margin="0,30,0,0" />
                                    <Border x:Name="Circle" Width="26" Height="26" CornerRadius="13" Background="{DynamicResource Input}" BorderBrush="{DynamicResource BoxEdge}" BorderThickness="1.5"
                                            VerticalAlignment="Top" Margin="0,2,0,0">
                                        <TextBlock x:Name="Number" Text="{Binding Number}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <!-- The border is always there, so marking the running step changes no size. -->
                                    <Border x:Name="Body" Grid.Column="1" CornerRadius="8" Padding="8.5,5.5,8.5,6.5" Margin="10,0,0,4" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5">
                                        <StackPanel>
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"
                                                               ToolTip="{DynamicResource Workflow.Retry}" Visibility="{Binding HasRetry, Converter={StaticResource VisibleWhenTrue}}" />
                                                    <Border Style="{StaticResource Badge}" Tag="{Binding IsSuccess}">
                                                        <TextBlock Text="{Binding Status}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Elapsed}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding State}" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <Grid DockPanel.Dock="Left" Width="52" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <Border CornerRadius="6" Background="{Binding Foreground, ElementName=StepBadge}" Opacity="0.14" />
                                                    <TextBlock x:Name="StepBadge" Text="{Binding Badge}" FontSize="10.5" FontWeight="Bold" themes:MethodColor.Of="{Binding Badge}"
                                                               HorizontalAlignment="Center" Margin="0,1" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                                <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </DockPanel>
                                                <!-- What the step takes in, then what it gives on to the next steps. -->
                                                <WrapPanel x:Name="Flow" Margin="0,4,0,0">
                                                    <ItemsControl ItemsSource="{Binding UsedNames}" Focusable="False">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Style="{StaticResource Chip}">
                                                                    <TextBlock Text="{Binding}" Style="{StaticResource ChipText}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock x:Name="Arrow" Text="&#x2192;" Foreground="{DynamicResource Muted}" Margin="2,0,6,0" VerticalAlignment="Center" />
                                                    <ItemsControl ItemsSource="{Binding SavedNames}" Focusable="False">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Style="{StaticResource SavedChip}">
                                                                    <TextBlock Text="{Binding}" Style="{StaticResource SavedChipText}" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsLast}" Value="True">
                                        <Setter TargetName="Line" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                        <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource Success}" />
                                        <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource Success}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasFailed}" Value="True">
                                        <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource Error}" />
                                        <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource Error}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource Attention}" />
                                        <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource Attention}" />
                                        <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Attention}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="Body" Property="Background" Value="{DynamicResource Card}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                        <Setter TargetName="Body" Property="Background" Value="{DynamicResource Card}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding UsedNames.Count}" Value="0">
                                        <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SavedNames.Count}" Value="0">
                                        <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding UsedNames.Count}" Value="0" />
                                            <Condition Binding="{Binding SavedNames.Count}" Value="0" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="Flow" Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <Grid Grid.Column="2" local:SplitMemory.Rows="WorkflowStep">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="200" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" MinHeight="200" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Panel}">
                    <DockPanel DataContext="{Binding SelectedStep}">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="&#xE711;" ToolTip="{DynamicResource Workflow.RemoveStep}" AutomationProperties.Name="{DynamicResource Workflow.RemoveStep}"
                                    Click="RemoveStep_Click" Style="{StaticResource CloseButton}" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Content="&#xE74B;" ToolTip="{DynamicResource Workflow.MoveDown}" AutomationProperties.Name="{DynamicResource Workflow.MoveDown}"
                                    Click="MoveDown_Click" Style="{StaticResource CloseButton}" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Content="&#xE74A;" ToolTip="{DynamicResource Workflow.MoveUp}" AutomationProperties.Name="{DynamicResource Workflow.MoveUp}"
                                    Click="MoveUp_Click" Style="{StaticResource CloseButton}" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Content="{DynamicResource Workflow.ShowScript}" Click="ShowScript_Click" FontSize="12" Padding="10,3" Margin="0,0,6,0" VerticalAlignment="Center"
                                    Style="{StaticResource PillButton}" Visibility="{Binding IsScript, Converter={StaticResource VisibleWhenTrue}}" />
                            <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,6,0">
                                <Run Text="{DynamicResource Workflow.Step}" />
                                <Run Text="{Binding Number, Mode=OneWay}" />
                                <Run Text="&#x00B7;" />
                            </TextBlock>
                            <!-- The name is written in the title. Without one, the step is known by what it calls. -->
                            <Grid VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Muted}" FontSize="13.5" FontWeight="SemiBold" Margin="2,0,0,0" TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Name}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Cell}" FontFamily="{StaticResource UiFont}" FontSize="13.5" FontWeight="SemiBold" Padding="0" Background="Transparent"
                                         AutomationProperties.Name="{DynamicResource Common.Name}" />
                            </Grid>
                        </DockPanel>
                        <StackPanel DockPanel.Dock="Top" Visibility="{Binding IsDelay, Converter={StaticResource VisibleWhenTrue}}">
                            <TextBlock Text="{DynamicResource Workflow.DelayMilliseconds}" Style="{StaticResource Heading}" Margin="0,0,0,6" />
                            <Border CornerRadius="8" Background="{DynamicResource Input}" Margin="0,0,0,12" Width="120" HorizontalAlignment="Left">
                                <TextBox Text="{Binding DelayMilliseconds, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Cell}" Padding="8,6" />
                            </Border>
                        </StackPanel>
                        <local:RequestLineEditor DockPanel.Dock="Top" DataContext="{Binding Request}" Margin="0,0,0,10" Visibility="{Binding DataContext.IsRequest, RelativeSource={RelativeSource AncestorType=DockPanel}, Converter={StaticResource VisibleWhenTrue}}" />
                        <Border DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource SegmentGroup}">
                                    <Style.Triggers>
                                        <!-- A wait has no tabs, unless a file gave it saves to remove. -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsDelay}" Value="True" />
                                                <Condition Binding="{Binding HasSaves}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="StepParamsSection" GroupName="StepSection" Style="{StaticResource Segment}" Visibility="{Binding IsRequest, Converter={StaticResource VisibleWhenTrue}}"
                                             IsChecked="{Binding Section, Converter={StaticResource IsEqual}, ConverterParameter={x:Static viewModels:StepSection.Params}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource Editor.Params}" />
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource UsedBadge}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Request.Query.EnabledCount}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Request.Query.EnabledCount}" Style="{StaticResource UsedBadgeText}" />
                                        </Border>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="StepHeadersSection" GroupName="StepSection" Style="{StaticResource Segment}" Visibility="{Binding IsRequest, Converter={StaticResource VisibleWhenTrue}}"
                                             IsChecked="{Binding Section, Converter={StaticResource IsEqual}, ConverterParameter={x:Static viewModels:StepSection.Headers}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource Editor.Headers}" />
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource UsedBadge}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Request.Headers.EnabledCount}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Request.Headers.EnabledCount}" Style="{StaticResource UsedBadgeText}" />
                                        </Border>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="StepBodySection" Content="{DynamicResource Editor.Body}" GroupName="StepSection" Style="{StaticResource Segment}" Visibility="{Binding IsRequest, Converter={StaticResource VisibleWhenTrue}}"
                                             IsChecked="{Binding Section, Converter={StaticResource IsEqual}, ConverterParameter={x:Static viewModels:StepSection.Body}}" />
                                <RadioButton x:Name="StepAuthSection" Content="{Binding AuthHeader}" GroupName="StepSection" Style="{StaticResource Segment}" Visibility="{Binding IsRequest, Converter={StaticResource VisibleWhenTrue}}"
                                             IsChecked="{Binding Section, Converter={StaticResource IsEqual}, ConverterParameter={x:Static viewModels:StepSection.Auth}}" />
                                <Button Click="RefreshStepAuth_Click" Style="{StaticResource RefreshAuthButton}" />
                                <RadioButton x:Name="StepRetrySection" GroupName="StepSection" Style="{StaticResource Segment}" Visibility="{Binding IsRequest, Converter={StaticResource VisibleWhenTrue}}"
                                             IsChecked="{Binding Section, Converter={StaticResource IsEqual}, ConverterParameter={x:Static viewModels:StepSection.Retry}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource Workflow.RetryTab}" />
                                        <Border Style="{StaticResource UsedBadge}" Visibility="{Binding HasRetry, Converter={StaticResource VisibleWhenTrue}}">
                                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="10" Style="{StaticResource UsedBadgeText}" Margin="0,2" />
                                        </Border>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="StepCodeSection" Content="{DynamicResource Workflow.Code}" GroupName="StepSection" Style="{StaticResource Segment}" Visibility="{Binding IsScript, Converter={StaticResource VisibleWhenTrue}}"
                                             IsChecked="{Binding Section, Converter={StaticResource IsEqual}, ConverterParameter={x:Static viewModels:StepSection.Code}}" />
                                <RadioButton x:Name="StepSavesSection" GroupName="StepSection" Style="{StaticResource Segment}"
                                             IsChecked="{Binding Section, Converter={StaticResource IsEqual}, ConverterParameter={x:Static viewModels:StepSection.Saves}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource Workflow.Saves}" />
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource UsedBadge}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Saves.EnabledCount}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Saves.EnabledCount}" Style="{StaticResource UsedBadgeText}" />
                                        </Border>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                        <!-- Only the chosen tab is shown, and it fills the panel, so only its own content scrolls. -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsDelay}" Value="True" />
                                                <Condition Binding="{Binding HasSaves}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <local:KeyValueEditor DataContext="{Binding Request.Query}" local:SplitMemory.Columns="Params" Visibility="{Binding IsChecked, ElementName=StepParamsSection, Converter={StaticResource VisibleWhenTrue}}" />
                            <local:KeyValueEditor DataContext="{Binding Request.Headers}" local:SplitMemory.Columns="Headers" Visibility="{Binding IsChecked, ElementName=StepHeadersSection, Converter={StaticResource VisibleWhenTrue}}" />
                            <local:RequestBodyEditor DataContext="{Binding Request}" Visibility="{Binding IsChecked, ElementName=StepBodySection, Converter={StaticResource VisibleWhenTrue}}" />
                            <local:AuthEditor DataContext="{Binding Auth}" InheritsFromWorkflow="True" Visibility="{Binding IsChecked, ElementName=StepAuthSection, Converter={StaticResource VisibleWhenTrue}}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="{Binding IsChecked, ElementName=StepRetrySection, Converter={StaticResource VisibleWhenTrue}}">
                                <StackPanel>
                                    <ToggleButton Content="{DynamicResource Workflow.Retry}" IsChecked="{Binding Retries}" Style="{StaticResource Switch}" HorizontalAlignment="Left" Margin="0,0,0,8" />
                                    <StackPanel Visibility="{Binding Retries, Converter={StaticResource VisibleWhenTrue}}">
                                        <WrapPanel>
                                            <TextBlock Text="{DynamicResource Workflow.RetryWhen}" VerticalAlignment="Center" Margin="0,0,8,6" />
                                            <Border CornerRadius="8" Background="{DynamicResource Input}" Width="200" Margin="0,0,6,6">
                                                <TextBox Text="{Binding RetryUntil, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Cell}" Padding="8,6" />
                                            </Border>
                                            <TextBlock Text="&#x3D;" VerticalAlignment="Center" Margin="0,0,6,6" />
                                            <Border CornerRadius="8" Background="{DynamicResource Input}" Width="140" Margin="0,0,0,6">
                                                <TextBox Text="{Binding RetryEquals, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Cell}" Padding="8,6" />
                                            </Border>
                                        </WrapPanel>
                                        <WrapPanel>
                                            <TextBlock Text="{DynamicResource Workflow.RetryStop}" VerticalAlignment="Center" Margin="0,0,8,6" />
                                            <Border CornerRadius="8" Background="{DynamicResource Input}" Width="200" Margin="0,0,6,6">
                                                <TextBox Text="{Binding RetryStopIf, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Cell}" Padding="8,6" />
                                            </Border>
                                            <TextBlock Text="&#x3D;" VerticalAlignment="Center" Margin="0,0,6,6" />
                                            <Border CornerRadius="8" Background="{DynamicResource Input}" Width="140" Margin="0,0,0,6">
                                                <TextBox Text="{Binding RetryStopEquals, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Cell}" Padding="8,6" />
                                            </Border>
                                        </WrapPanel>
                                        <WrapPanel>
                                            <TextBlock Text="{DynamicResource Workflow.RetryTimes}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Border CornerRadius="8" Background="{DynamicResource Input}" Width="60" Margin="0,0,8,0">
                                                <TextBox Text="{Binding RetryTimes, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Cell}" Padding="8,6" />
                                            </Border>
                                            <TextBlock Text="{DynamicResource Workflow.RetryWait}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Border CornerRadius="8" Background="{DynamicResource Input}" Width="72" Margin="0,0,8,0">
                                                <TextBox Text="{Binding RetryWaitMilliseconds, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Cell}" Padding="8,6" />
                                            </Border>
                                            <TextBlock Text="{DynamicResource Workflow.RetryMilliseconds}" VerticalAlignment="Center" />
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                            <DockPanel Visibility="{Binding IsChecked, ElementName=StepCodeSection, Converter={StaticResource VisibleWhenTrue}}">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{DynamicResource Workflow.Output}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="2,0,10,0" />
                                    <Border Style="{StaticResource SegmentGroup}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Content="{DynamicResource Workflow.OutputJson}" GroupName="ScriptOutput" Style="{StaticResource Segment}"
                                                         IsChecked="{Binding Output, Converter={StaticResource IsEqual}, ConverterParameter={x:Static scripts:ScriptOutput.Json}}" />
                                            <RadioButton Content="{DynamicResource Workflow.OutputHtml}" GroupName="ScriptOutput" Style="{StaticResource Segment}"
                                                         IsChecked="{Binding Output, Converter={StaticResource IsEqual}, ConverterParameter={x:Static scripts:ScriptOutput.Html}}" />
                                            <RadioButton Content="{DynamicResource Workflow.OutputXml}" GroupName="ScriptOutput" Style="{StaticResource Segment}"
                                                         IsChecked="{Binding Output, Converter={StaticResource IsEqual}, ConverterParameter={x:Static scripts:ScriptOutput.Xml}}" />
                                            <RadioButton Content="{DynamicResource Workflow.OutputText}" GroupName="ScriptOutput" Style="{StaticResource Segment}"
                                                         IsChecked="{Binding Output, Converter={StaticResource IsEqual}, ConverterParameter={x:Static scripts:ScriptOutput.Text}}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <Border CornerRadius="8" Background="{DynamicResource Input}">
                                    <controls:ScriptEditor Code="{Binding DataContext.Code, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Border>
                            </DockPanel>
                            <DockPanel Visibility="{Binding IsChecked, ElementName=StepSavesSection, Converter={StaticResource VisibleWhenTrue}}">
                                <!-- What a step saves is picked from its response, where the saved lines are marked. -->
                                <local:KeyValueEditor DataContext="{Binding Saves}" local:SplitMemory.Columns="Saves" NameHeader="{DynamicResource Workflow.Variable}" ValueHeader="{DynamicResource Workflow.From}" CanDisable="False">
                                    <local:KeyValueEditor.Resources>
                                        <!-- Where to save from is a path such as $.id, not a reference to other names. -->
                                        <Style TargetType="controls:VariableTextBox" BasedOn="{StaticResource Cell}" />
                                    </local:KeyValueEditor.Resources>
                                </local:KeyValueEditor>
                            </DockPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="Transparent" />

                <local:ResponseView Grid.Row="2" DataContext="{Binding SelectedStep}">
                    <local:ResponseView.Footer>
                        <WrapPanel Margin="0,8,0,0">
                            <WrapPanel.Style>
                                <Style TargetType="WrapPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SavedValues.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </WrapPanel.Style>
                            <TextBlock Text="{DynamicResource Workflow.SavedValues}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ItemsControl ItemsSource="{Binding SavedValues}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                            <Border Style="{StaticResource SavedChip}">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource SavedChipText}" />
                                            </Border>
                                            <TextBlock Text="{Binding Value}" FontFamily="{StaticResource CodeFont}" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>
                    </local:ResponseView.Footer>
                </local:ResponseView>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
