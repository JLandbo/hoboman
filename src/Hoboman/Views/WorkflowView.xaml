<UserControl x:Class="Hoboman.Views.WorkflowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hoboman.Views"
             xmlns:controls="clr-namespace:Hoboman.Controls"
             xmlns:viewModels="clr-namespace:Hoboman.ViewModels">
    <UserControl.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="Background" Value="{DynamicResource SuccessSoft}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                    <Setter Property="Background" Value="{DynamicResource ErrorSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Success}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource Error}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Panel}" Margin="0,0,0,12">
            <DockPanel>
                <Grid DockPanel.Dock="Right" Margin="8,0,0,0">
                    <Button Content="{DynamicResource Workflow.Run}" Command="{Binding Send}" Padding="18,6">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="{DynamicResource Common.Cancel}" Click="Cancel_Click" Style="{StaticResource PillButton}" Padding="18,6"
                            Visibility="{Binding IsRunning, Converter={StaticResource VisibleWhenTrue}}" />
                </Grid>
                <Button DockPanel.Dock="Right" Content="{DynamicResource Editor.Save}" Command="{Binding Save}" Style="{StaticResource PillButton}" FontSize="12" Padding="12,4" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Workflow.Crumb}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" />
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Attention}" Margin="6,0,0,0" VerticalAlignment="Center"
                             Visibility="{Binding IsDirty, Converter={StaticResource VisibleWhenTrue}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12" Background="{DynamicResource ErrorSoft}" BorderBrush="{DynamicResource ErrorEdge}" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Problems.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xEA39;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Error}" Margin="0,2,10,0" />
                <StackPanel>
                    <TextBlock Text="{DynamicResource Workflow.CannotRun}" Foreground="{DynamicResource Error}" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding Problems}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="260" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Panel}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="{DynamicResource Workflow.ParametersHint}" Style="{StaticResource Hint}" />
                        <TextBlock Text="{DynamicResource Workflow.Parameters}" Style="{StaticResource Heading}" />
                    </DockPanel>
                    <local:KeyValueEditor DockPanel.Dock="Top" DataContext="{Binding Parameters}" ValueHeader="{DynamicResource Workflow.Default}" CanDisable="False" MaxHeight="180" Margin="0,0,0,12">
                        <local:KeyValueEditor.Resources>
                            <!-- A default is a literal JSON value, not a reference to other names. -->
                            <Style TargetType="controls:VariableTextBox" BasedOn="{StaticResource Cell}" />
                        </local:KeyValueEditor.Resources>
                    </local:KeyValueEditor>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="{DynamicResource Workflow.VariablesHint}" Style="{StaticResource Hint}" />
                        <TextBlock Text="{DynamicResource Workflow.Variables}" Style="{StaticResource Heading}" />
                    </DockPanel>
                    <local:KeyValueEditor DockPanel.Dock="Top" DataContext="{Binding Variables}" ValueHeader="{DynamicResource Workflow.Default}" CanDisable="False" MaxHeight="180" Margin="0,0,0,12">
                        <local:KeyValueEditor.Resources>
                            <Style TargetType="controls:VariableTextBox" BasedOn="{StaticResource Cell}" />
                        </local:KeyValueEditor.Resources>
                    </local:KeyValueEditor>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <ToggleButton x:Name="AddStepToggle" DockPanel.Dock="Right" Style="{StaticResource PillToggle}" FontSize="12" Padding="10,3" Checked="AddStepToggle_Checked"
                                      IsHitTestVisible="{Binding IsOpen, ElementName=AddStepPopup, Converter={StaticResource Not}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="{DynamicResource Workflow.AddRequest}" />
                            </StackPanel>
                        </ToggleButton>
                        <Popup x:Name="AddStepPopup" IsOpen="{Binding IsChecked, ElementName=AddStepToggle}" PlacementTarget="{Binding ElementName=AddStepToggle}"
                               StaysOpen="False" AllowsTransparency="True">
                            <Border Style="{StaticResource Menu}" MinWidth="260" MaxHeight="420" TextElement.FontSize="12">
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                        <ItemsControl x:Name="RequestList" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding}" Style="{StaticResource MenuButton}" Click="AddStep_Click" HorizontalAlignment="Stretch" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock Text="{DynamicResource Tree.Empty}" Foreground="{DynamicResource Muted}" Margin="10,6">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Items.Count, ElementName=RequestList}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Popup>
                        <TextBlock Text="{DynamicResource Workflow.Steps}" Style="{StaticResource Heading}" />
                    </DockPanel>
                    <Grid>
                        <ListBox ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep}" Style="{StaticResource SideList}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type viewModels:WorkflowStepViewModel}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Width="20" Text="{Binding Number}" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" />
                                        <TextBlock DockPanel.Dock="Left" Width="58" Text="{Binding Method}" FontSize="11" FontWeight="Bold"
                                                   Foreground="{Binding Method, Converter={StaticResource MethodBrush}}" VerticalAlignment="Center" />
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                            <Border Style="{StaticResource Badge}">
                                                <TextBlock Text="{Binding Status}" Style="{StaticResource BadgeText}" />
                                            </Border>
                                            <TextBlock Text="{Binding Elapsed}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding State}" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock x:Name="Summary" Text="{Binding Summary}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Summary}" Value="">
                                            <Setter TargetName="Summary" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{DynamicResource Workflow.NoSteps}" Foreground="{DynamicResource Muted}" Margin="8,4,0,0" TextWrapping="Wrap" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Steps.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="200" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="2*" MinHeight="160" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Panel}">
                    <Grid>
                        <DockPanel DataContext="{Binding SelectedStep}">
                            <DockPanel.Style>
                                <Style TargetType="DockPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Content="&#xE711;" ToolTip="{DynamicResource Workflow.RemoveStep}" AutomationProperties.Name="{DynamicResource Workflow.RemoveStep}"
                                        Click="RemoveStep_Click" Style="{StaticResource CloseButton}" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Content="&#xE74B;" ToolTip="{DynamicResource Workflow.MoveDown}" AutomationProperties.Name="{DynamicResource Workflow.MoveDown}"
                                        Click="MoveDown_Click" Style="{StaticResource CloseButton}" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Content="&#xE74A;" ToolTip="{DynamicResource Workflow.MoveUp}" AutomationProperties.Name="{DynamicResource Workflow.MoveUp}"
                                        Click="MoveUp_Click" Style="{StaticResource CloseButton}" VerticalAlignment="Center" />
                                <TextBlock VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis">
                                    <Run Text="{DynamicResource Workflow.Step}" Foreground="{DynamicResource Muted}" />
                                    <Run Text="{Binding Number, Mode=OneWay}" Foreground="{DynamicResource Muted}" />
                                    <Run Text="&#x00B7;" Foreground="{DynamicResource Muted}" />
                                    <Run Text="{Binding Folder, Mode=OneWay}" Foreground="{DynamicResource Muted}" />
                                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                </TextBlock>
                            </DockPanel>
                            <ScrollViewer x:Name="StepDetail" VerticalScrollBarVisibility="Auto" Focusable="False" PreviewMouseWheel="StepDetail_PreviewMouseWheel">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Workflow.Uses}" Style="{StaticResource Heading}" Margin="0,0,0,6" />
                                    <Border CornerRadius="8" Background="{DynamicResource Box}" BorderBrush="{DynamicResource BoxEdge}" BorderThickness="1" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid Margin="8,6,8,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{DynamicResource Table.Name}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="4,0" />
                                                <TextBlock Grid.Column="1" Text="{DynamicResource Workflow.Source}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="4,0" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Uses}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type viewModels:WorkflowUse}">
                                                        <Border BorderBrush="{DynamicResource BoxEdge}" BorderThickness="0,1,0,0" Padding="8,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition />
                                                                    <ColumnDefinition />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource CodeFont}" Foreground="{DynamicResource Attention}" Margin="4,0" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock x:Name="Source" Grid.Column="1" Text="{Binding Source}" Foreground="{DynamicResource Muted}" Margin="4,0" TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                <Setter TargetName="Source" Property="Foreground" Value="{DynamicResource Error}" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{DynamicResource Workflow.With}" Style="{StaticResource Heading}" Margin="0,0,0,6" />
                                    <local:KeyValueEditor DataContext="{Binding With}" Margin="0,0,0,12" />
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock Text="{DynamicResource Workflow.SavesHint}" Style="{StaticResource Hint}" />
                                        <TextBlock Text="{DynamicResource Workflow.Saves}" Style="{StaticResource Heading}" />
                                    </DockPanel>
                                    <local:KeyValueEditor DataContext="{Binding Saves}" NameHeader="{DynamicResource Workflow.Variable}" ValueHeader="{DynamicResource Workflow.From}" CanDisable="False">
                                        <local:KeyValueEditor.Resources>
                                            <!-- Where to save from is a path such as $.id, not a reference to other names. -->
                                            <Style TargetType="controls:VariableTextBox" BasedOn="{StaticResource Cell}" />
                                        </local:KeyValueEditor.Resources>
                                    </local:KeyValueEditor>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                        <TextBlock Text="{DynamicResource Workflow.NoSteps}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedStep}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="Transparent" />

                <Border Grid.Row="2" Style="{StaticResource Panel}">
                    <DockPanel DataContext="{Binding SelectedStep}">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Response.Title}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,12,0" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Response}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Style="{StaticResource Badge}" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Response.Status}" Style="{StaticResource BadgeText}" FontSize="12" />
                                </Border>
                                <TextBlock Text="{Binding Response.Elapsed}" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding Response.Size}" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="BodySection" Content="{DynamicResource Response.Body}" GroupName="WorkflowResponseSection" IsChecked="True" Style="{StaticResource Segment}" />
                                <RadioButton x:Name="HeadersSection" GroupName="WorkflowResponseSection" Style="{StaticResource Segment}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{DynamicResource Response.Headers}" />
                                        <TextBlock Text="{Binding Response.HeaderCount}" Margin="4,0,0,0" Opacity="0.7" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </DockPanel>

                        <Border DockPanel.Dock="Top" CornerRadius="8" Padding="12,10" Margin="0,0,0,8" Background="{DynamicResource ErrorSoft}" BorderBrush="{DynamicResource ErrorEdge}" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xEA39;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Error}" Margin="0,2,10,0" />
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Workflow.StepFailed}" Foreground="{DynamicResource Error}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Error}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Grid>
                            <Border CornerRadius="8" Background="{DynamicResource Input}" Visibility="{Binding IsChecked, ElementName=BodySection, Converter={StaticResource VisibleWhenTrue}}">
                                <controls:BodyView Body="{Binding Response.Body}" Coloring="{Binding Response.Coloring, FallbackValue={x:Static viewModels:BodyFormat.Raw}}" />
                            </Border>
                            <TextBox Text="{Binding Response.Headers, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource Code}"
                                     Visibility="{Binding IsChecked, ElementName=HeadersSection, Converter={StaticResource VisibleWhenTrue}}" />
                            <TextBlock Text="{DynamicResource Workflow.ResponseEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Response}" Value="{x:Null}" />
                                                    <Condition Binding="{Binding Error}" Value="{x:Null}" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
