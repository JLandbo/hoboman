<UserControl x:Class="Hoboman.Views.ResponseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Hoboman.Views"
             xmlns:controls="clr-namespace:Hoboman.Controls"
             xmlns:viewModels="clr-namespace:Hoboman.ViewModels">
    <Border Style="{StaticResource Panel}">
        <DockPanel>
            <!-- The status goes on its own line, to the right, where it does not fit beside the sections, as in a narrow workflow. -->
            <Grid x:Name="HeaderRow" DockPanel.Dock="Top" Margin="0,0,0,8" SizeChanged="Header_SizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel x:Name="HeaderLeft" Orientation="Horizontal" SizeChanged="Header_SizeChanged">
                    <TextBlock Text="{DynamicResource Response.Title}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,12,0" />
                    <RadioButton x:Name="BodySection" Content="{DynamicResource Response.Body}" GroupName="ResponseSection" IsChecked="{Binding Result.ResponseSection, Converter={StaticResource IsEqual}, ConverterParameter={x:Static viewModels:ResponseSection.Body}}" Style="{StaticResource Segment}" />
                    <RadioButton x:Name="HeadersSection" GroupName="ResponseSection" IsChecked="{Binding Result.ResponseSection, Converter={StaticResource IsEqual}, ConverterParameter={x:Static viewModels:ResponseSection.Headers}}" Style="{StaticResource Segment}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Response.Headers}" />
                            <TextBlock Text="{Binding Result.Response.HeaderCount}" Margin="4,0,0,0" Opacity="0.7" />
                        </StackPanel>
                    </RadioButton>
                    <Border Margin="12,0,0,0">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource SegmentGroup}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Result.Response}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=BodySection}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="{DynamicResource Format.Json}" GroupName="BodyFormat" Style="{StaticResource Segment}"
                                         IsChecked="{Binding Result.BodyFormat, Converter={StaticResource IsEqual}, ConverterParameter={x:Static viewModels:BodyFormat.Json}}" />
                            <RadioButton Content="{DynamicResource Format.Xml}" GroupName="BodyFormat" Style="{StaticResource Segment}"
                                         IsChecked="{Binding Result.BodyFormat, Converter={StaticResource IsEqual}, ConverterParameter={x:Static viewModels:BodyFormat.Xml}}" />
                            <RadioButton Content="{DynamicResource Format.Html}" GroupName="BodyFormat" Style="{StaticResource Segment}"
                                         IsChecked="{Binding Result.BodyFormat, Converter={StaticResource IsEqual}, ConverterParameter={x:Static viewModels:BodyFormat.Html}}" />
                            <RadioButton Content="{DynamicResource Format.Raw}" GroupName="BodyFormat" Style="{StaticResource Segment}"
                                         IsChecked="{Binding Result.BodyFormat, Converter={StaticResource IsEqual}, ConverterParameter={x:Static viewModels:BodyFormat.Raw}}" />
                            <RadioButton x:Name="BrowserFormat" Content="&#xE774;" FontFamily="{StaticResource IconFont}" GroupName="BodyFormat" Style="{StaticResource Segment}"
                                         ToolTip="{DynamicResource Format.Browser}" AutomationProperties.Name="{DynamicResource Format.Browser}"
                                         IsChecked="{Binding Result.BodyFormat, Converter={StaticResource IsEqual}, ConverterParameter={x:Static viewModels:BodyFormat.Browser}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="HeaderRight" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" SizeChanged="Header_SizeChanged">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Result.Response}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ToggleButton Content="{DynamicResource Base64.WholeBody}" IsChecked="{Binding Result.Base64.DecodesWholeResponse}" Style="{StaticResource Switch}" Margin="0,0,14,0"
                                  VerticalAlignment="Center" Visibility="{Binding IsChecked, ElementName=BodySection, Converter={StaticResource VisibleWhenTrue}}" />
                    <Border Style="{StaticResource StatusPill}" Tag="{Binding Result.Response.IsSuccess}" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Result.Response.Status}" />
                    </Border>
                    <TextBlock Text="{Binding Result.Response.Elapsed}" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Text="{Binding Result.Response.Size}" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" />
                    <Button x:Name="SaveResponse" Command="{Binding Result.SaveAs}" ToolTip="{DynamicResource Response.SaveAs}" AutomationProperties.Name="{DynamicResource Response.SaveAs}"
                            Style="{StaticResource PrimaryButton}" FontSize="12" Padding="9,3" Margin="8,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource Common.Save}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Border DockPanel.Dock="Top" CornerRadius="8" Padding="12,10" Margin="0,0,0,8" Background="{DynamicResource ErrorSoft}" BorderBrush="{DynamicResource ErrorEdge}" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Problem}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xEA39;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource Error}" Margin="0,2,10,0" />
                    <StackPanel>
                        <TextBlock Text="{Binding Problem.Title}" Foreground="{DynamicResource Error}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Problem.Details}" Foreground="{DynamicResource Text}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ContentPresenter DockPanel.Dock="Bottom" Content="{Binding Footer, RelativeSource={RelativeSource AncestorType=local:ResponseView}}" />
            <Grid>
                <DockPanel Visibility="{Binding IsChecked, ElementName=BodySection, Converter={StaticResource VisibleWhenTrue}}">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Result.ResponseBodyProblem}" Foreground="{DynamicResource Error}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Result.ResponseBodyProblem}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Result.ResponseBodyProblem}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border CornerRadius="8" Background="{DynamicResource Input}">
                        <Grid>
                            <Grid>
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=BrowserFormat}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <controls:BodyView x:Name="BodyText" DataContext="{Binding Result}" Body="{Binding Response.Body}" Coloring="{Binding Response.Coloring, FallbackValue={x:Static viewModels:BodyFormat.Raw}}"
                                                   Marks="{Binding ResponseMarks}" MarkToggled="Body_MarkToggled" />
                                <TextBlock Text="{DynamicResource Response.Loading}" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding IsLoading, ElementName=BodyText, Converter={StaticResource VisibleWhenTrue}}" />
                            </Grid>
                            <controls:BrowserView Page="{Binding Result.Page}" Background="{DynamicResource Input}" Margin="6" Visibility="{Binding IsChecked, ElementName=BrowserFormat, Converter={StaticResource VisibleWhenTrue}}" />
                        </Grid>
                    </Border>
                </DockPanel>
                <TextBox Text="{Binding Result.Response.Headers, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource Code}"
                         Visibility="{Binding IsChecked, ElementName=HeadersSection, Converter={StaticResource VisibleWhenTrue}}" />
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSending}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Text" Value="{DynamicResource Response.Sending}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
