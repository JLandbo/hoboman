<local:DialogWindow x:Class="Hoboman.Views.ConfirmDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Hoboman.Views"
                    Width="460" SizeToContent="Height">
    <StackPanel>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <ItemsControl x:Name="ItemList" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,0" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="{DynamicResource Common.Cancel}" Command="{x:Static SystemCommands.CloseWindowCommand}" Style="{StaticResource PillButton}" Margin="0,0,8,0" />
            <Button x:Name="ConfirmButton" Click="Confirm_Click" IsDefault="True" Style="{StaticResource PrimaryButton}" />
        </StackPanel>
    </StackPanel>
</local:DialogWindow>
