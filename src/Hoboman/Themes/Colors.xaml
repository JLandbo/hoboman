<!-- The colours of the default theme, Sort og gul. Every colour the app draws with is here, so a theme can give any of them its own. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Surface" Color="#F0262626" />
    <SolidColorBrush x:Key="SolidSurface" Color="#262626" />
    <SolidColorBrush x:Key="Edge" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="Text" Color="#F2F2F2" />
    <SolidColorBrush x:Key="Muted" Color="#B8B8B8" />
    <SolidColorBrush x:Key="Attention" Color="#F5C542" />
    <SolidColorBrush x:Key="OnAttention" Color="#1E1E1E" />
    <SolidColorBrush x:Key="Input" Color="#1E1E1E" />
    <SolidColorBrush x:Key="Button" Color="#3A3A3A" />
    <SolidColorBrush x:Key="Error" Color="#FF6B6B" />
    <SolidColorBrush x:Key="Handle" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="Card" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="Box" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="BoxEdge" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Success" Color="#6BDD9A" />
    <!-- What a button blinks after it did something (Views/Blink.cs). -->
    <SolidColorBrush x:Key="ClipboardSuccess" Color="#22C55E" />
    <SolidColorBrush x:Key="ClipboardError" Color="#EF4444" />
    <SolidColorBrush x:Key="SuccessSoft" Color="#266BDD9A" />
    <SolidColorBrush x:Key="ErrorSoft" Color="#24FF6B6B" />
    <SolidColorBrush x:Key="ErrorEdge" Color="#8CFF6B6B" />
    <SolidColorBrush x:Key="MethodGET" Color="#6BDD9A" />
    <SolidColorBrush x:Key="MethodPOST" Color="#FFE47E" />
    <SolidColorBrush x:Key="MethodPUT" Color="#74AEF6" />
    <SolidColorBrush x:Key="MethodPATCH" Color="#C0A8E1" />
    <SolidColorBrush x:Key="MethodDELETE" Color="#F79A8E" />
    <SolidColorBrush x:Key="MethodHEAD" Color="#6BDD9A" />
    <SolidColorBrush x:Key="MethodOPTIONS" Color="#F15EB0" />
    <SolidColorBrush x:Key="Json.FieldName" Color="#9CDCFE" />
    <SolidColorBrush x:Key="Json.String" Color="#CE9178" />
    <SolidColorBrush x:Key="Json.Number" Color="#B5CEA8" />
    <SolidColorBrush x:Key="Json.Bool" Color="#569CD6" />
    <SolidColorBrush x:Key="Json.Null" Color="#569CD6" />
    <SolidColorBrush x:Key="Json.Punctuation" Color="#F2F2F2" />
    <SolidColorBrush x:Key="XML.XmlTag" Color="#569CD6" />
    <SolidColorBrush x:Key="XML.XmlDeclaration" Color="#569CD6" />
    <SolidColorBrush x:Key="XML.DocType" Color="#569CD6" />
    <SolidColorBrush x:Key="XML.AttributeName" Color="#9CDCFE" />
    <SolidColorBrush x:Key="XML.AttributeValue" Color="#CE9178" />
    <SolidColorBrush x:Key="XML.CData" Color="#CE9178" />
    <SolidColorBrush x:Key="XML.Entity" Color="#CE9178" />
    <SolidColorBrush x:Key="XML.BrokenEntity" Color="#FF6B6B" />
    <SolidColorBrush x:Key="XML.Comment" Color="#6A9955" />
    <SolidColorBrush x:Key="JavaScript.Digits" Color="#B5CEA8" />
    <SolidColorBrush x:Key="JavaScript.Comment" Color="#6A9955" />
    <SolidColorBrush x:Key="JavaScript.String" Color="#CE9178" />
    <SolidColorBrush x:Key="JavaScript.Character" Color="#CE9178" />
    <SolidColorBrush x:Key="JavaScript.Regex" Color="#CE9178" />
    <SolidColorBrush x:Key="JavaScript.JavaScriptKeyWords" Color="#569CD6" />
    <SolidColorBrush x:Key="JavaScript.JavaScriptIntrinsics" Color="#9CDCFE" />
    <SolidColorBrush x:Key="JavaScript.JavaScriptLiterals" Color="#569CD6" />
    <SolidColorBrush x:Key="JavaScript.JavaScriptGlobalFunctions" Color="#9CDCFE" />
    <!-- Lighter shades the code draws with: the editor's selection, the tint of a line chosen for Base64, saved from or not decodable, and the badge and drop marks. -->
    <SolidColorBrush x:Key="Selection" Color="#66F5C542" />
    <SolidColorBrush x:Key="AttentionTint" Color="#12F5C542" />
    <SolidColorBrush x:Key="ErrorTint" Color="#14FF6B6B" />
    <SolidColorBrush x:Key="SuccessTint" Color="#146BDD9A" />
    <SolidColorBrush x:Key="AttentionSoft" Color="#24F5C542" />
</ResourceDictionary>
